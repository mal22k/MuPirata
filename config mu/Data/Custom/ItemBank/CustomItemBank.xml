<!--
DOCUMENTACION SILENTDEVS
Archivo: CustomItemBank.xml
Funcion: Banco custom de items/joyas con deposito, retiro y autoloot.
Como configurar: Enable del nodo CustomItemBank activa/desactiva el sistema completo. Active activa cada item; AutoLoot envia al banco al recoger.
Activar/Desactivar: Para desactivar todo use Enable="0". Para desactivar un item use Active="0".
Notas: Traduccion: khong = no; gui = depositar/enviar; rut = retirar; toi da = maximo.
Importante: no borrar este archivo si el source lo carga directamente; use Enable="0" o quite entradas concretas.
-->
<!-- 
//=========================================================================================================================================
// WWW.SILENTDEVS.NET - PREMIUM
//=========================================================================================================================================
	Enable
-->
<CustomItemBank Enable="1" >
	<Message>
	<!-- Mess-->
		<Msg Index="0"	Text="[Banco] Esta funcion no esta disponible." />
		<Msg Index="1"	Text="[Banco] No tienes %s en el inventario para guardar." />
		<Msg Index="2"	Text="[Banco] No tienes suficientes joyas para retirar." />
		<Msg Index="3"	Text="[Banco] Solo puedes guardar un maximo de %d %s." />
		<Msg Index="4"	Text="[Banco] Guardaste (+%d) %s en el banco." />
		<Msg Index="5"	Text="[Banco] Retiraste (%d) %s del banco." />
		<Msg Index="6"	Text="[Banco] No tienes espacio suficiente en el inventario." />
	</Message>
<!-- Active = 0 no se muestra en el banco y no permite guardar/retirar.
		AutoLoot = 1 envia automaticamente al banco al recoger el item, sin pasar por el inventario.
		AutoLoot = 0 conserva el deposito manual; el jugador aun puede activar su AutoPick individual desde la ventana.
		ItemIndex,ItemLevel = Item
		MaxCountTypeX = cantidad maxima permitida segun tipo de cuenta/VIP (0, 1, 2, 3).
	-->
	<ListBank>
